PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway
DATABASE_SSL=true

# Shopify Dev Dashboard app credentials. Keep these server-side only.
SHOPIFY_SHOP_DOMAIN=9zgiqv-ug.myshopify.com
SHOPIFY_CLIENT_ID=replace_me
SHOPIFY_CLIENT_SECRET=replace_me

# Required to call POST /jobs/run. Generate with: openssl rand -hex 32
JOB_SECRET=replace_me

# Signs unsubscribe links. Use a different random value from JOB_SECRET.
UNSUBSCRIBE_SECRET=replace_me

# Preview is the safe default: email jobs are rendered and logged, never delivered.
EMAIL_MODE=preview
EMAIL_FROM=Printmivo <hello@printmivo.com>
STORE_URL=https://printmivo.com

# Set only when ready to deliver real email through Resend.
RESEND_API_KEY=

# Campaign timings and frequency controls.
ABANDONED_CHECKOUT_DELAY_MINUTES=90
POST_PURCHASE_DELAY_DAYS=7
MARKETING_COOLDOWN_DAYS=7
